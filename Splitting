//This is the collection of different types of duplicate rows all grouped together in their respective groups
for encoded_disease,duplicate_row in indra_chowk.groupby(leak_list):
     display(duplicate_row)


//Groups of duplicate rows are made and ngroup() assigns an ID to each group and also assigns each 4920 rows with the ID of their respective groups.
